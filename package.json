{
  "name": "pokelections",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lambdas": "esbuild lambdas/vote/index.ts --bundle --platform=node --target=node24 --outfile=dist/lambdas/vote/index.js --minify --external:@aws-sdk",
    "build:all": "npm run build && npm run build:lambdas",
    "lint": "oxlint",
    "preview": "vite preview",
    "tsx": "tsx",
    "test": "jest",
    "cdk": "cdk",
    "deploy": "npm run build:all && npm run cdk deploy"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1163.0",
    "@aws-sdk/lib-dynamodb": "^3.1163.0",
    "@dnd-kit/react": "^0.5.3",
    "@tanstack/react-query": "^5.105.3",
    "aws-lambda": "^1.0.7",
    "install": "^0.13.0",
    "npm": "^11.21.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@rolldown/plugin-babel": "^0.2.4",
    "@swc/core": "^1.15.0",
    "@swc/jest": "^0.2.39",
    "@types/aws-lambda": "^8.10.164",
    "@types/babel__core": "^7.20.5",
    "@types/jest": "^30",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "aws-cdk": "^2.1147.0",
    "aws-cdk-lib": "^2.275.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "constructs": "^10.5.0",
    "esbuild": "0.28.2",
    "jest": "^25.1.0",
    "oxlint": "^1.89.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
